# .htaccess
RewriteEngine On
RewriteBase /

# Redirect pmb.ubpkarawang.ac.id ke penmabar.ubpkarawang.ac.id
RewriteCond %{HTTP_HOST} ^pmb\.ubpkarawang\.ac\.id$ [NC]
RewriteRule ^(.*)$ https://penmabar.ubpkarawang.ac.id/$1 [R=301,L]

# Atau jika hanya redirect root
RewriteCond %{HTTP_HOST} ^pmb\.ubpkarawang\.ac\.id$ [NC]
RewriteRule ^$ https://penmabar.ubpkarawang.ac.id/ [R=301,L]